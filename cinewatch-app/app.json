{
  "expo": {
    "name": "CineMood",
    "slug": "cinemood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B14"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.miguelzack.cinemood",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B14"
      },
      "edgeToEdgeEnabled": true,
      "statusBar": {
        "backgroundColor": "#0B0B14",
        "barStyle": "light-content"
      },
      "navigationBar": {
        "backgroundColor": "#0B0B14",
        "barStyle": "light-content"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "cinemood",
    "primaryColor": "#E50914",
    "extra": {
      "eas": {
        "projectId": "b1e5e346-e542-45fc-a597-36658404c5ef"
      }
    }
  }
}
